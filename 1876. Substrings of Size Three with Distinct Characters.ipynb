   "outputs": [],
   "source": [
    "class Solution:\n",
    "    def countGoodSubstrings(self, s: str) -> int:\n",
    "        count = 0\n",
    "        for i in range(len(s)-3+1):\n",
    "            if len(set(s[i:i+3]))==len(s[i:i+3]):\n",
    "                count+=1\n",
    "\n",
    "        return count"
   ]
  }
