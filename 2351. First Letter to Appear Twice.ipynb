   "source": [
    "class Solution:\n",
    "    def repeatedCharacter(self, s: str) -> str:\n",
    "        l = set()\n",
    "        for i in s:\n",
    "            if i in l:\n",
    "                return i\n",
    "            else:\n",
    "                l.add(i)"
   ]
  }
