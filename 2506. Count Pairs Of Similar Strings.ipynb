   "outputs": [],
   "source": [
    "class Solution:\n",
    "    def similarPairs(self, words: List[str]) -> int:\n",
    "        c = 0\n",
    "        for i in range(len(words)):\n",
    "            for j in range(i+1, len(words)):\n",
    "                if set(words[i])==set(words[j]):\n",
    "                    c+=1\n",
    "\n",
    "        return c"
   ]
  }
