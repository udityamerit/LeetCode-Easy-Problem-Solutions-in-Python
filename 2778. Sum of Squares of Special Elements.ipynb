   "source": [
    "class Solution:\n",
    "    def sumOfSquares(self, nums: List[int]) -> int:\n",
    "        ans= 0\n",
    "        for i in range(1, len(nums)+1):\n",
    "            if len(nums)%i==0:\n",
    "                ans+=nums[i-1]**2\n",
    "        return ans\n",
    "    "
   ]
  }
