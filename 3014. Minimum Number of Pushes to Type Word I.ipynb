   "outputs": [],
   "source": [
    "class Solution:\n",
    "    def minimumPushes(self, word: str) -> int:\n",
    "        n  = len(word)\n",
    "        ans = 0\n",
    "        for i in range(n):\n",
    "            ans+=(i//8)+1\n",
    "        \n",
    "        return ans"
   ]
  }
