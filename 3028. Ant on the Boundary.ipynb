   "source": [
    "class Solution:\n",
    "    def returnToBoundaryCount(self, nums: List[int]) -> int:\n",
    "        ret = 0\n",
    "        cnt =0\n",
    "        for i in nums:\n",
    "            ret+=i\n",
    "            if ret==0:\n",
    "                cnt +=1\n",
    "        \n",
    "        return cnt"
   ]
  }
