   "outputs": [],
   "source": [
    "class Solution:\n",
    "    def getEncryptedString(self, s: str, k: int) -> str:\n",
    "        new_st = \"\"\n",
    "        for i in range(len(s)):\n",
    "            new = ((i+k)%len(s))\n",
    "            new_st+=s[new]\n",
    "        \n",
    "        return new_st"
   ]
  }
