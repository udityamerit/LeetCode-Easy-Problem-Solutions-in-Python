   "id": "8132b4d6",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Solution:\n",
    "    def missingMultiple(self, nums: List[int], k: int) -> int:\n",
    "        n =len(nums)\n",
    "        mul = [k*i for i in range(1, n+2)]\n",
    "        for j in mul:\n",
    "            if j not in nums:\n",
    "                return j"
   ]
  }
