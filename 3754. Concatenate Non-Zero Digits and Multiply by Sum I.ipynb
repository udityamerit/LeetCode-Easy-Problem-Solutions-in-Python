   "source": [
    "class Solution:\n",
    "    def sumAndMultiply(self, n: int) -> int:\n",
    "        l = [int(i) for i in str(n) if i!='0']\n",
    "        print(l)\n",
    "        s = sum(l)\n",
    "        c = 0\n",
    "        for i in l:\n",
    "            c = c*10+i\n",
    "\n",
    "        return c*s"
   ]
  }
